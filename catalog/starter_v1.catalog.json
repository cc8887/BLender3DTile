  "authoring_requirements": {
    "kit_files": [
      "catalog manifest",
      "trusted procedural generator",
      "region/UV templates embedded in generator"
    ],
    "humanoid_extra_files": [
      "fixed bone coordinates and weight rules in rig.py/geometry.py",
      "catalog topology_sha256",
      "model_data.json per build"
    ],
    "hashes": "Built-in procedural sources are pinned by source_hashes; every build also hashes all runtime source. No external .blend file is needed for these eight kits.",
    "charts": "Per face-corner local UVs; keep curved chart continuity. Tile grids are authored geometry with repeated per-cell UVs, never REPEAT the whole atlas. Character templates reserve padding between their internal islands as well as around the outer atlas rectangle.",
    "region_identity": "Semantic face groups on immutable kit topology; never raw polygon indices in public API.",
    "sockets": "Local frames denote a shared mating interface with identical basis at fit; flush mating transform is identity. Validate certified kit/socket pairs and dimensions from socket_types, scaled by equal positive uniform instance scales. Solve full child world matrix = parent_world * parent_socket * inverse(child_socket). This includes parent uniform scale; do not multiply child scale again. Convert world to local if parenting; the previous child placement is replaced.",
    "texture_defaults": "Build initialization creates all atlas defaults once using versioned pattern/color-role/face-landmark definitions. place only references these job-local images and never resets pixels. paint_tile may run before or after place and override each tile at most once; unused tiles are not exported separately."
  },
  "validation": {
    "phases": [
      "strict_json",
      "schema",
      "plan_semantics",
      "blender_preflight",
      "pose_smoke",
      "glb_postflight",
      "target_engine_smoke"
    ],
    "semantic_checks": [
      "at least one mesh instance; static prop_v1 contains no skinned kits",
      "ids declared before use and unique",
      "region belongs to referenced kit",
      "slot and tile compatible with region",
      "patterns compatible with tile",
      "pixel marks within inner content rectangle",
      "one paint per tile",
      "attach sockets exist, type and dimensions match, equal uniform scales, no occupied sockets or graph cycles",
      "no attach for skinned kit in v1",
      "bind only supported topology, once; all character assets bound before export",
      "asset_kind matches kits; one humanoid instance in character_v1",
      "exactly one final export_glb; no commands after it"
    ],
    "required_glb_checks": [
      "Khronos validator zero errors",
      "no external buffer/image URI; PNG images embedded with bufferView",
      "pixel sampler minFilter=9728 magFilter=9728 wrapS=33071 wrapT=33071",
      "all referenced textures/materials present",
      "for character: mesh node references skin, 20 expected joints, JOINTS_0/WEIGHTS_0 and inverse bind matrices",
      "valid finite normalized weights, at most 4 influences; no hidden truncation by exporter",
      "UV seam vertex duplicates carry identical weights"
    ],
    "initial_template_thresholds": {
      "weight_sum_abs_error": 0.0001,
      "rest_reconstruction_error_m": 1e-05,
      "seam_gap_m": 1e-05,
      "joint_edge_stretch_p99_max": 2,
      "joint_edge_stretch_absolute_max": 3
    },
    "threshold_note": "Engineering starting points; calibrate deformation/collapse limits on the authored template, and use glTF Validator's own stricter format tolerances after export. Numerical checks do not replace visual review.",
    "reproduction": "Pin recipe, catalog and asset hashes, seed, Blender build and exporter. Compare geometry/texture/rig content; byte-identical GLB is not promised."
  },
